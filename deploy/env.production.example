# Production environment file template.
# On the Droplet, copy to /opt/bookiscout/.env.production and fill in values.
# NEVER commit the actual .env.production to git.

# ─────────────────────────────────────────────────────────────
# Public site URL (used by sitemap.ts, opengraph images, canonical tags)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bookiscout.com

# ─────────────────────────────────────────────────────────────
# Supabase (for Stay Check cache + rate limiting)
# After migration to Supabase Edge Functions, the Next.js app
# only needs the URL and ANON key to call the Edge Function.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ─────────────────────────────────────────────────────────────
# Booking.com affiliate
# ─────────────────────────────────────────────────────────────
BOOKING_AFFILIATE_ID=YOUR_AFFILIATE_ID

# ─────────────────────────────────────────────────────────────
# Google Analytics (if used)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─────────────────────────────────────────────────────────────
# Node runtime
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ─────────────────────────────────────────────────────────────
# NOTE: API keys for article generation (GEMINI_*, PEXELS_*, UNSPLASH_*)
# are NOT needed on the Droplet — they only run in GitHub Actions cron.
# Keep them in GitHub Secrets only.
# ─────────────────────────────────────────────────────────────
